{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 05 – Model Performance Evaluation\n",
    "This notebook evaluates the three models trained in Phase 8 on the chronological test set.\n",
    "Metrics reported include standard regression scores (MAE, RMSE, R²) and binary‑classification\n",
    "scores (accuracy, precision, recall, F1) where the target label is defined as *above the median* daily consumption."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd, numpy as np, joblib\n",
    "from pathlib import Path\n",
    "from sklearn.metrics import (mean_absolute_error, mean_squared_error, r2_score,\n",
    "                         accuracy_score, precision_score, recall_score, f1_score)\n",
    "\n",
    "# Paths – same layout as the project\n",
    "PROJECT_ROOT = Path('..').resolve()  # notebook is inside notebooks/\n",
    "FEATURES_PARQUET = PROJECT_ROOT / 'data' / 'processed' / 'features_dataset.parquet'\n",
    "DESIGN_CSV = PROJECT_ROOT / 'data' / 'processed' / 'experimental_design_info.csv'\n",
    "MODELS_DIR = PROJECT_ROOT / 'models'\n",
    "\n",
    "TARGET = 'meter_reading_daily'\n",
    "\n",
    "def split_by_date(df):\n",
    "    df = df.copy()\n",
    "    df['date'] = pd.to_datetime(df['date']).dt.date\n",
    "    train = (df['date'] >= pd.to_datetime('2016-01-01').date()) & (df['date'] <= pd.to_datetime('2016-12-31').date())\n",
    "    val   = (df['date'] >= pd.to_datetime('2017-01-01').date()) & (df['date'] <= pd.to_datetime('2017-06-30').date())\n",
    "    test  = (df['date'] >= pd.to_datetime('2017-07-01').date()) & (df['date'] <= pd.to_datetime('2017-12-31').date())\n",
    "    return train, val, test\n",
    "\n",
    "# Load data and join treatment mapping\n",
    "print('Loading features …')\n",
    "df = pd.read_parquet(FEATURES_PARQUET)\n",
    "df['date'] = pd.to_datetime(df['date']).dt.date\n",
    "design = pd.read_csv(DESIGN_CSV)\n",
    "df = df.merge(design, on='building_id', how='left')\n",
    "train_mask, val_mask, test_mask = split_by_date(df)\n",
    "test_df = df[test_mask].reset_index(drop=True)\n",
    "print(f'Test rows: {len(test_df):,}')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Prepare feature matrix and target vector\n",
    "We drop identifier columns and the `treatment` column – the latter is only needed for the RBD allocation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "feature_cols = [c for c in test_df.columns if c not in ['building_id','site_id','date',TARGET,'treatment']]\n",
    "X_test = test_df[feature_cols]\n",
    "y_test = test_df[TARGET]\n",
    "print(f'Feature columns: {len(feature_cols)}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Helper: evaluate one model\n",
    "Returns a dictionary with regression and binary‑classification metrics.\n",
    "Binary label = 1 if daily consumption is **≥ median** of the test set, otherwise 0."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def eval_model(model_path, X, y):\n",
    "    model = joblib.load(model_path)\n",
    "    preds = model.predict(X)\n",
    "    mae = mean_absolute_error(y, preds)\n",
    "    rmse = np.sqrt(mean_squared_error(y, preds))\n",
    "    r2 = r2_score(y, preds)\n",
    "    # binary classification metrics\n",
    "    median_val = y.median()\n",
    "    y_bin = (y >= median_val).astype(int)\n",
    "    pred_bin = (preds >= median_val).astype(int)\n",
    "    acc = accuracy_score(y_bin, pred_bin)\n",
    "    prec = precision_score(y_bin, pred_bin, zero_division=0)\n",
    "    rec = recall_score(y_bin, pred_bin, zero_division=0)\n",
    "    f1 = f1_score(y_bin, pred_bin, zero_division=0)\n",
    "    return {'MAE': mae, 'RMSE': rmse, 'R2': r2, 'Accuracy': acc, 'Precision': prec, 'Recall': rec, 'F1': f1}\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Evaluate all three models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "results = []\n",
    "for name in ['DecisionTree', 'RandomForest', 'GradientBoosting']:\n",
    "    model_path = MODELS_DIR / f'{name.lower()}_model.pkl'\n",
    "    if not model_path.exists():\n",
    "        print(f'⚠️  Missing model file: {model_path}')\n",
    "        continue\n",
    "    metrics = eval_model(model_path, X_test, y_test)\n",
    "    metrics['Model'] = name\n",
    "    results.append(metrics)\n",
    "    print(f'Evaluated {name}')\n",
    "\n",
    "summary_df = pd.DataFrame(results)\n",
    "summary_df = summary_df[['Model','MAE','RMSE','R2','Accuracy','Precision','Recall','F1']]\n",
    "summary_df"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Save the evaluation table\n",
    "The table is also written to `results/tables/06_evaluation_summary.csv` for reproducibility."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "OUTPUT_CSV = PROJECT_ROOT / 'results' / 'tables' / '06_evaluation_summary.csv'\n",
    "summary_df.to_csv(OUTPUT_CSV, index=False)\n",
    "print('Saved evaluation CSV →', OUTPUT_CSV.relative_to(PROJECT_ROOT))"
   ]
  }
 ],
